# Caches, logs and temporary files
.cache/
__pycache__/
*.py[cod]
*.log
*.tmp
*.swp
*.swo
*~
.DS_Store

# Local backups, reports and archives
backups/
installation.json
*-installation.json
sync-expected.json
*.zip
*.tar
*.tar.gz

# Local credentials and tooling state
.env
.env.*
!.env.example
secrets.*
/.ssh/
/.aws/
/.codex/

# Runtime state; keep the clean Noctalia override seed
/.local/state/*
!/.local/state/noctalia/
/.local/state/noctalia/*
!/.local/state/noctalia/settings.toml

# Generated themes and local monitor mode
/.config/hypr/noctalia.lua
/.config/hypr/single-monitor
/.config/pcmanfm-qt/**/recent-files.conf
/.config/gtk-3.0/noctalia.css
/.config/gtk-4.0/noctalia.css

# Browser profiles contain personal data; only the theme templates are tracked.
/.config/zen/
/.zen/
