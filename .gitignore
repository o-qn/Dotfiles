# Caches, logs and temporary files
.cache/
__pycache__/
*.py[cod]
*.log
*.tmp
*.swp
*.swo
*~
.DS_Store

# Local backups, reports and archives
backups/
installation.json
*-installation.json
sync-expected.json
*.zip
*.tar
*.tar.gz

# Local credentials and tooling state
.env
.env.*
!.env.example
secrets.*
/.ssh/
/.aws/
/.codex/

# Runtime state; keep the clean Noctalia override seed
/.local/state/*
!/.local/state/noctalia/
/.local/state/noctalia/*
!/.local/state/noctalia/settings.toml

# Generated themes and local monitor mode
/.config/hypr/noctalia.lua
/.config/hypr/single-monitor
/.config/hypr/portrait-workspace
/.config/hypr/main-workspace
/.config/hypr/portrait-only
/.config/gtk-3.0/noctalia.css
/.config/gtk-4.0/noctalia.css

# Browser profiles contain personal data; only the theme templates are tracked.
/.config/zen/
/.zen/

# Generated Neovim palette and editor state
/.config/nvim/lua/noctalia_palette.lua
/.config/nvim/.lazy/
/.config/nvim/lazyvim.json.bak

# Dolphin browsing state is machine-local.
/.local/share/dolphin/

# Keep the video folder; large local wallpaper clips stay machine-local.
/.local/share/wallpapers/videos/*
!/.local/share/wallpapers/videos/.gitkeep
