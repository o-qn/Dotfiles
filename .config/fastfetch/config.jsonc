{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "height": 15,
        "width": 30,
        "padding": {
            "top": 3,
            "left": 2,
            "right": 3
        },
        "color": {
            "1": "magenta",
            "2": "cyan"
        }
    },
    "display": {
        "separator": "  ",
        "key": {
            "width": 17
        },
        "color": {
            "title": "magenta",
            "separator": "90"
        },
        "percent": {
            "type": 1,
            "color": {
                "green": "green",
                "yellow": "yellow",
                "red": "red"
            }
        }
    },
    "modules": [
        {
            "type": "title",
            "key": "\u001b[90m╭─\u001b[0m \u001b[1;35m\u001b[0m",
            "keyWidth": 5,
            "format": "\u001b[1;35m{user-name}\u001b[0;90m@\u001b[1;36m{host-name}\u001b[0m"
        },
        {
            "type": "custom",
            "format": "\u001b[90m├─ \u001b[1;32m󰍛  Hardware \u001b[0;90m────────────────────────────────────\u001b[0m"
        },
        {
            "type": "host",
            "key": "\u001b[90m│\u001b[0;32m  󰌢  Host",
            "format": "{name}"
        },
        {
            "type": "cpu",
            "key": "\u001b[90m│\u001b[0;32m  󰻠  CPU",
            "format": "{name} ({cores-logical}) @ {freq-max}"
        },
        {
            "type": "gpu",
            "key": "\u001b[90m│\u001b[0;32m  󰢮  GPU",
            "format": "{vendor} {name}"
        },
        {
            "type": "memory",
            "key": "\u001b[90m│\u001b[0;32m  󰑭  Memory",
            "format": "{used} / {total} ({percentage})"
        },
        {
            "type": "disk",
            "key": "\u001b[90m│\u001b[0;32m  󰋊  Disk",
            "folders": "/",
            "format": "{size-used} / {size-total} ({size-percentage}) \u001b[90m·\u001b[0m {filesystem}"
        },
        {
            "type": "custom",
            "format": "\u001b[90m├─ \u001b[1;36m󰣆  Software \u001b[0;90m────────────────────────────────────\u001b[0m"
        },
        {
            "type": "os",
            "key": "\u001b[90m│\u001b[0;36m    OS"
        },
        {
            "type": "kernel",
            "key": "\u001b[90m│\u001b[0;36m  󰌽  Kernel",
            "format": "{release}"
        },
        {
            "type": "packages",
            "key": "\u001b[90m│\u001b[0;36m  󰏗  Packages"
        },
        {
            "type": "shell",
            "key": "\u001b[90m│\u001b[0;36m  󰞷  Shell"
        },
        {
            "type": "lm",
            "key": "\u001b[90m│\u001b[0;34m  󰍁  Login"
        },
        {
            "type": "wm",
            "key": "\u001b[90m│\u001b[0;34m  󱂬  WM"
        },
        {
            "type": "terminal",
            "key": "\u001b[90m│\u001b[0;34m  󰆍  Terminal"
        },
        {
            "type": "custom",
            "format": "\u001b[90m├─ \u001b[1;35m󰅐  Session \u001b[0;90m─────────────────────────────────────\u001b[0m"
        },
        {
            "type": "command",
            "key": "\u001b[90m│\u001b[0;35m  󰃭  OS Age",
            "text": "b=$(stat -c %W /); [ \"$b\" -gt 0 ] 2>/dev/null && echo \"$(( ($(date +%s) - b) / 86400 )) days\" || echo unknown"
        },
        {
            "type": "uptime",
            "key": "\u001b[90m│\u001b[0;35m  󰔟  Uptime"
        },
        {
            "type": "datetime",
            "key": "\u001b[90m│\u001b[0;35m  󰥔  DateTime",
            "format": "{year}-{month-pretty}-{day-pretty} \u001b[90m·\u001b[0m {hour-pretty}:{minute-pretty}"
        },
        {
            "type": "custom",
            "format": "\u001b[90m╰──────────────────────────────────────────────────\u001b[0m"
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
