layout {

    focus-ring {
        active-color   "#677de4"
        inactive-color "#12162b"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#677de4"
        inactive-color "#12162b"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#677de4"
        inactive-color "#142885"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#677de480"
    }
}

recent-windows {
    highlight {
        active-color "#677de4"
        urgent-color "#fd4663"
    }
}
