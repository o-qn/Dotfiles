layout {

    focus-ring {
        active-color   "#5e99ed"
        inactive-color "#061a37"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#5e99ed"
        inactive-color "#061a37"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#5e99ed"
        inactive-color "#0d418b"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#5e99ed80"
    }
}

recent-windows {
    highlight {
        active-color "#5e99ed"
        urgent-color "#fd4663"
    }
}
