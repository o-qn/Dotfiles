#!/usr/bin/env python3
"""Backward-compatible entrypoint delegating to umbriel-ctl with JSON output."""
import os
from pathlib import Path
import sys

CTL = Path(__file__).resolve().with_name("umbriel-ctl")


def main() -> None:
    argv = list(sys.argv[1:])
    if not argv or argv[0].startswith("-"):
        cmd = ["status", *argv]
    else:
        cmd = argv
        subcmd = cmd[0]
        if subcmd not in ("status", "apply-state", "-h", "--help"):
            if "--json" not in cmd:
                cmd.append("--json")
            if "--quiet" not in cmd and "--notify" not in cmd and subcmd != "watcher-opt":
                cmd.append("--notify")
    os.execv(sys.executable, [sys.executable, str(CTL), *cmd])


if __name__ == "__main__":
    main()
