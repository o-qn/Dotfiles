#!/usr/bin/env python3
"""Toggle Variable Refresh Rate (VRR) on Umbriel without hardcoding connectors or reloading config."""
import os
from pathlib import Path
import sys

CTL = Path(__file__).resolve().with_name("umbriel-ctl")


def main() -> None:
    argv = list(sys.argv[1:])
    if "-h" not in argv and "--help" not in argv and "--quiet" not in argv and "--notify" not in argv:
        argv.append("--notify")
    os.execv(sys.executable, [sys.executable, str(CTL), "vrr", *argv])


if __name__ == "__main__":
    main()
