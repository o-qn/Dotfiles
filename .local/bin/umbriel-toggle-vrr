#!/usr/bin/env bash
set -euo pipefail

MONITOR="DP-2"
OVERRIDE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/umbriel/vrr-override.toml"

current="fullscreen"
if [[ -f "$OVERRIDE_FILE" ]]; then
    if grep -q 'vrr = "always"' "$OVERRIDE_FILE"; then
        current="always"
    elif grep -q 'vrr = "disabled"' "$OVERRIDE_FILE"; then
        current="disabled"
    fi
fi

case "${1:-toggle}" in
    fullscreen|auto) next="fullscreen" ;;
    always|on)       next="always" ;;
    disabled|off)    next="disabled" ;;
    toggle|*)
        case "$current" in
            fullscreen) next="always" ;;
            always)     next="disabled" ;;
            *)          next="fullscreen" ;;
        esac
        ;;
esac

cat > "$OVERRIDE_FILE" <<EOF
# Managed by ~/.local/bin/umbriel-toggle-vrr (Super+Shift+D)
# Modes: "fullscreen" (Smart Auto), "always" (Force On), "disabled" (Off)
[output.$MONITOR]
vrr = "$next"
EOF

umbriel msg config-reload >/dev/null 2>&1 || true

case "$next" in
    fullscreen) label="Smart Auto (Fullscreen + Games)" ;;
    always)     label="Enabled (Always On)" ;;
    disabled)   label="Disabled (Fixed 200Hz)" ;;
esac

if command -v noctalia >/dev/null 2>&1; then
    noctalia msg notification-show "VRR ($MONITOR)" "$label" >/dev/null 2>&1 || true
elif command -v notify-send >/dev/null 2>&1; then
    notify-send -u low -t 1800 "VRR ($MONITOR)" "$label"
fi
