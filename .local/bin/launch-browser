#!/usr/bin/env bash
set -euo pipefail

for candidate in brave-origin brave-origin-stable brave-browser brave; do
    if command -v "$candidate" >/dev/null 2>&1; then
        exec "$candidate" "$@"
    fi
done

if command -v flatpak >/dev/null 2>&1 && flatpak info com.brave.Origin >/dev/null 2>&1; then
    exec flatpak run com.brave.Origin "$@"
fi

exec xdg-open https://
