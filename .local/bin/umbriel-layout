#!/usr/bin/env python3
"""Workspace-specific layout switcher for Umbriel (delegates to umbriel-ctl)."""
import os
from pathlib import Path
import sys

CTL = Path(__file__).resolve().with_name("umbriel-ctl")


def main() -> None:
    os.execv(sys.executable, [sys.executable, str(CTL), "layout", *sys.argv[1:]])


if __name__ == "__main__":
    main()
