#!/usr/bin/env bash
set -euo pipefail

is_niri() {
    command -v niri >/dev/null 2>&1 && [[ -n "${NIRI_SOCKET:-}" && -S "${NIRI_SOCKET}" ]] && niri msg version >/dev/null 2>&1
}

is_umbriel() {
    if ! command -v umbriel >/dev/null 2>&1; then
        return 1
    fi
    if [[ -n "${UMBRIEL_SOCKET:-}" ]]; then
        [[ -S "${UMBRIEL_SOCKET}" ]]
        return
    fi
    umbriel outputs -j >/dev/null 2>&1
}

detect_compositor() {
    if is_umbriel; then
        printf 'umbriel\n'
    elif is_niri; then
        printf 'niri\n'
    else
        printf 'hyprland\n'
    fi
}

notify_msg() {
    local title="$1"
    local body="$2"
    if command -v noctalia >/dev/null 2>&1 && noctalia msg notification-show "$title" "$body" >/dev/null 2>&1; then
        return 0
    fi
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -u normal "$title" "$body" >/dev/null 2>&1 || true
    fi
}

validate_umbriel() {
    local json_out
    if ! json_out=$(umbriel config validate --json 2>&1); then
        printf '%s\n' "$json_out" >&2
        notify_msg "Umbriel configuration needs attention" "$json_out"
        return 1
    fi
    local diag_report
    if ! diag_report=$(python3 -c '
import json, sys
data = json.loads(sys.stdin.read())
diags = data.get("diagnostics") or []
if not data.get("valid", False) or diags:
    for d in diags:
        sev = str(d.get("severity", "error")).upper()
        fname = d.get("file", "")
        line = d.get("line", "?")
        msg = d.get("message", "")
        print(f"{sev} {fname}:{line}: {msg}")
    sys.exit(1)
' <<< "$json_out" 2>&1); then
        printf '%s\n' "$diag_report" >&2
        notify_msg "Umbriel configuration needs attention" "$diag_report"
        return 1
    fi
}

reload_desktop() {
    local label="$1"
    shift
    local report

    if ! report=$(noctalia config validate 2>&1) || [[ "$report" == *"WARN "* ]]; then
        printf '%s\n' "$report" >&2
        notify_msg "Noctalia configuration needs attention" "$report"
        exit 1
    fi

    "$@"
    noctalia msg config-reload
    notify_msg "Desktop" "$label configuration reloaded."
}

target="${1:-$(detect_compositor)}"
hypr_root="${HYPR_CONFIG_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/hypr}"

case "$target" in
    umbriel)
        validate_umbriel || exit 1
        reload_desktop "Umbriel" umbriel msg config-reload
        ;;
    niri)
        if ! report=$(niri validate 2>&1); then
            printf '%s\n' "$report" >&2
            notify_msg "Niri configuration needs attention" "$report"
            exit 1
        fi
        reload_desktop "Niri" niri msg action load-config-file
        ;;
    hyprland|hypr)
        if ! report=$(Hyprland --verify-config -c "$hypr_root/hyprland.lua" 2>&1); then
            printf '%s\n' "$report" >&2
            notify_msg "Hyprland configuration needs attention" "$report"
            exit 1
        fi
        reload_desktop "Hyprland" hyprctl reload
        ;;
    *)
        printf 'Usage: desktop-reload [umbriel|niri|hyprland]\n' >&2
        exit 2
        ;;
esac
